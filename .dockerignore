# Keep the build context small and prevent local state/secrets from being baked
# into image layers. Everything the bot needs at runtime is under the repo root
# (Python modules, assets) or is installed by the Dockerfile.

# --- Version control / local tooling ---------------------------------------
.git
.gitignore
.github/
.devcontainer/
.vscode/
.idea/

# --- Environment files and secrets -----------------------------------------
.env
.env.*
*.pem
*.key

# --- Python build/runtime artifacts ----------------------------------------
**/__pycache__/
__pycache__/
**/*.py[cod]
**/*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Local state, logs and SQLite databases --------------------------------
# data/ also contains Python modules, so only exclude the mutable files.
**/*.log
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*_state.json
**/discord.log

# --- Files that only matter on the host ------------------------------------
README.md
docker-compose.yml
Dockerfile
.dockerignore
.DS_Store
